# Copy to .env for local development (never commit .env). On a hosting service, set these as
# environment variables in its dashboard instead.

# --- Access -------------------------------------------------------------------------------
# Make each hash with:  npm run hash-password
STUDENT_PASSWORD_HASH=
ADMIN_USERNAME=admin
ADMIN_NAME=Dr Wesam Alzwawy
ADMIN_PASSWORD_HASH=
# (For a quick local test only, plain values also work: STUDENT_PASSWORD=..., ADMIN_PASSWORD=...)

# Session length in hours
SESSION_HOURS_STUDENT=168
SESSION_HOURS_ADMIN=12

# --- Server ------------------------------------------------------------------------------
PORT=3000
# Where drafts, uploaded pictures (before publishing), history and sessions are kept.
# Must be on a persistent disk in production.
DATA_DIR=./data
# Behind an HTTPS proxy (Render, Railway, Fly.io, nginx…): trust X-Forwarded-* and always send Secure cookies.
TRUST_PROXY=0
COOKIE_SECURE=auto
MAX_UPLOAD_MB=10

# --- Publishing to GitHub (optional but strongly recommended) -------------------------------
# Fine-grained personal access token limited to this repository with "Contents: Read and write".
GITHUB_TOKEN=
GITHUB_REPO=third-year-med/Vulvar-pathology
GITHUB_BRANCH=main
GITHUB_COMMITTER_NAME=Pathology platform
GITHUB_COMMITTER_EMAIL=platform@users.noreply.github.com
